+        assert z.set_calls == [(W, win32con.HWND_TOPMOST,
+                                win32con.SWP_NOMOVE | win32con.SWP_NOSIZE | win32con.SWP_NOACTIVATE)]
+        pm.update_position.assert_called_once()   # a placement pass: the pin block re-derives
