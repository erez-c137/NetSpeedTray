diff --git a/src/netspeedtray/constants/config.py b/src/netspeedtray/constants/config.py
index 4342156..24824e2 100644
--- a/src/netspeedtray/constants/config.py
+++ b/src/netspeedtray/constants/config.py
@@ -198,6 +198,11 @@ class ConfigConstants:
     DEFAULT_START_WITH_WINDOWS: Final[bool] = True
     DEFAULT_TRAY_OFFSET_X: Final[int] = 0
     DEFAULT_TRAY_OFFSET_Y: Final[int] = 3
+    # The left-anchor pin's drag offset (`left_anchor_drag_dx`): how far RIGHT of the left anchor
+    # (the Widgets/weather button's right edge, or the bar's left edge) the user dragged the
+    # widget, in logical px. Never negative - the widget cannot be dragged onto the shell button
+    # it is anchored off. Reset position clears it back to 0.
+    DEFAULT_LEFT_ANCHOR_DRAG_DX: Final[int] = 0
     # Pre-1.3.0 tray_offset_x defaults (10 up to 1.2.0, then 1, then 3; 0 since 1.3.0). Every
     # config those versions saved carries one of them although the user never moved the widget, so
     # Reset position (shown only once the widget was moved) treats them as the default too (rc.2 W6).
@@ -327,7 +332,11 @@ class ConfigConstants:
         "power_display_enabled": False,    # opt-in: the hover card's battery rows (live draw / projected)
         "show_hover_tips": True,           # the hover card's right-click/double-click gesture hint
         "pause_in_menu": False,            # opt-in: surface Pause/Resume in the right-click menu
-        "pin_left_edge": False,            # opt-in: fix the widget 15px from the screen's left edge (General > Behavior)
+        "pin_left_edge": False,            # opt-in: anchor the widget to the left end of a top/bottom taskbar (Widget page)
+        # The pin's drag offset: how far right of the left anchor the user dragged the widget
+        # (logical px, >= 0 - measured from the anchor, never from tray_offset_x). Cleared by
+        # Reset position, like the tray drag offsets.
+        "left_anchor_drag_dx": DEFAULT_LEFT_ANCHOR_DRAG_DX,
         "context_menu_hidden_items": list(DEFAULT_CONTEXT_MENU_HIDDEN_ITEMS),  # ids from CONTEXT_MENU_HIDEABLE_ITEMS
         "dark_mode": DEFAULT_DARK_MODE,
         "history_period": data.history_period.DEFAULT_PERIOD,
@@ -513,6 +522,7 @@ class ConfigConstants:
         "show_hover_tips": {"type": bool, "default": True},
         "pause_in_menu": {"type": bool, "default": False},
         "pin_left_edge": {"type": bool, "default": False},
+        "left_anchor_drag_dx": {"type": int, "default": DEFAULT_LEFT_ANCHOR_DRAG_DX, "min": 0, "max": 10000},
         # "item_choices": unknown ids (incl. "settings"/"exit", which always show) are dropped one by
         # one and duplicates collapsed - a bad entry never costs the user the rest of the list. The default
         # is its own list (as in DEFAULT_CONFIG), never the shared constant.
diff --git a/src/netspeedtray/constants/layout.py b/src/netspeedtray/constants/layout.py
index a96be76..c35ed69 100644
--- a/src/netspeedtray/constants/layout.py
+++ b/src/netspeedtray/constants/layout.py
@@ -75,11 +75,14 @@ class LayoutConstants:
     # Minimum gap (logical px) kept between the widget's tray-side edge and the tray boundary /
     # the "^" show-hidden-icons chevron, so the widget never abuts it and steals its clicks (#161 pt1).
     TRAY_EDGE_MIN_GAP_PX: Final[int] = 8
-    # Left-edge pin (Settings > General > Behavior): fixes the widget 15px from its screen's left
-    # edge at any resolution. Logical px, so DPI scaling keeps the same visual inset on every
-    # display; the PositionManager re-derives it from the CURRENT screen geometry on every
-    # re-placement, so a resolution or monitor change re-pins to the new edge automatically.
-    PIN_LEFT_EDGE_OFFSET_PX: Final[int] = 15
+    # Left-anchor pin (Settings > Widget): the widget is anchored to the FIRST shell thing on the
+    # LEFT of a top/bottom taskbar - the Widgets/weather button's right edge when one is there,
+    # else the bar's left edge - and kept this many logical px off it (so DPI scaling keeps the
+    # same visual gap on every display; the PositionManager re-derives the anchor from the CURRENT
+    # bar layout on every re-placement). Same rule as TRAY_EDGE_MIN_GAP_PX - never abut a shell
+    # button and steal its clicks - but a separate constant, so tuning the tray side does not
+    # move this one.
+    LEFT_ANCHOR_GAP_PX: Final[int] = 8
     # Minimum gap (logical px) kept between the widget and the Win11 Widgets/weather button when that
     # button sits between the widget's default spot and the tray (a LEFT-aligned bar puts it right
     # beside the tray). The same rule as the tray gap: never abut a shell button and steal its clicks
